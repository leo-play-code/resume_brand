generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id              String   @id @default(uuid())
  name            String
  description     String   @default("")
  longDescription String   @default("") @map("long_description")
  videoUrl        String   @default("") @map("video_url")
  heroType        String   @default("mp4") @map("hero_type")
  heroJsCode        String?  @map("hero_js_code")
  nameEn            String?  @map("name_en")
  descriptionEn     String?  @map("description_en")
  longDescriptionEn String?  @map("long_description_en")
  githubUrl         String?  @map("github_url")
  liveUrl         String?  @map("live_url")
  techStack       String[] @map("tech_stack")
  featured        Boolean  @default(false)
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("projects")
}

model TechStack {
  id           String  @id @default(uuid())
  name         String
  color        String  @default("#ffffff")
  icon         String? @map("icon")
  rowNumber    Int     @default(1) @map("row_number")
  displayOrder Int     @default(0) @map("display_order")

  @@map("tech_stack")
}

model Experience {
  id           String   @id @default(uuid())
  company      String
  companyEn    String?  @default("") @map("company_en")
  role         String
  period       String
  description  String[]
  type          String   @default("work")
  roleEn        String?  @default("") @map("role_en")
  descriptionEn String[] @default([]) @map("description_en")
  displayOrder  Int      @default(0) @map("display_order")

  @@map("experiences")
}

model Skill {
  id        String   @id @default(uuid())
  nameZh    String   @map("name_zh")
  nameEn    String   @map("name_en")
  category  String
  isCustom  Boolean  @default(false) @map("is_custom")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category])
  @@index([isActive])
  @@map("skills")
}

model SiteSettings {
  id              String   @id @default("singleton")
  backgroundDark  String   @default("#050510") @map("background_dark")
  backgroundLight String   @default("#f4f1ff") @map("background_light")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
