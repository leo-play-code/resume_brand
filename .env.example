# ─────────────────────────────────────────────────────
# Environment variables template — commit this file
# Copy to .env.local for local dev
# Set these in your deployment platform (Vercel / Railway / Render) for production
# ─────────────────────────────────────────────────────

# Dev server port (local only — production port is controlled by the platform)
PORT=3001

# ── Personal Info ─────────────────────────────────────
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_OWNER_INITIALS=
NEXT_PUBLIC_OWNER_EMAIL=
NEXT_PUBLIC_OWNER_TAGLINE=

# ── Social Links ──────────────────────────────────────
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TWITTER_URL=

# ── Site URL ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_META_DESCRIPTION=

# ── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ── Prisma ────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
# DATABASE_URL: Transaction pooler (port 6543) — used at runtime
# DIRECT_URL:   Direct connection (port 5432)  — used by prisma migrate
DATABASE_URL=""
DIRECT_URL=""


# ── NextAuth (GitHub OAuth) ───────────────────────────
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_ID=
